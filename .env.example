# prack configuration. Copy to .env and adjust. All variables are optional.

# --- server ---------------------------------------------------------------
# PRACK_HOST=127.0.0.1          # 0.0.0.0 to listen on all interfaces (Docker sets this)
# PRACK_PORT=8000
# PRACK_DATA_DIR=data           # SQLite database, terrain tile cache
# PRACK_LOG_LEVEL=INFO

# Protect the whole app with HTTP basic auth (strongly recommended on a public server)
# PRACK_AUTH_USER=pilot
# PRACK_AUTH_PASSWORD=choose-a-long-password

# --- database -------------------------------------------------------------
# Default: SQLite in PRACK_DATA_DIR. For PostgreSQL:
# PRACK_DATABASE_URL=postgresql+psycopg://prack:change-me@postgres:5432/prack
# POSTGRES_PASSWORD=change-me

# --- regions --------------------------------------------------------------
# Comma separated region ids (files in prack/regions or PRACK_REGIONS_DIR)
# PRACK_REGIONS=ch
# PRACK_REGIONS_DIR=/path/to/my/regions

# --- OGN feed ------------------------------------------------------------
# PRACK_OGN_ENABLED=true
# PRACK_OGN_HOST=aprs.glidernet.org
# PRACK_OGN_PORT=14580
# PRACK_OGN_CALLSIGN=PRACK1234   # read-only login name, must be unique on the OGN servers
# PRACK_OGN_FILTER_MARGIN_KM=30  # receive a bit beyond the region box (cross-border legs)

# Simulated traffic instead of the OGN feed (also seeds two demo days)
# PRACK_DEMO=false

# --- tracking --------------------------------------------------------------
# OGN aircraft types to record: 1 glider, 6 hang glider, 7 paraglider
# (add e.g. 2 tow plane, 3 helicopter, 8 powered aircraft if wanted)
# PRACK_TRACKED_TYPES=1,6,7
# PRACK_RESPECT_STEALTH=true
# PRACK_MIN_FIX_INTERVAL=2        # seconds between stored fixes per aircraft
# PRACK_FLIGHT_GAP_MINUTES=20     # silence that ends a flight
# PRACK_FLIGHT_RESUME_MINUTES=90  # airborne again within this time: same flight
# PRACK_LANDING_MINUTES=4         # stationary this long on the ground: landed
# PRACK_LIVE_WINDOW_MINUTES=10
# PRACK_STORE_RAW=false           # also keep the raw APRS sentence of every fix

# --- services --------------------------------------------------------------
# PRACK_DDB_ENABLED=true          # OGN device database (registrations, privacy flags)
# PRACK_ELEVATION_ENABLED=true    # terrain elevation (AGL, ground profile, 3D terrain)
# PRACK_ELEVATION_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
# PRACK_WEATHER_ENABLED=true      # daily weather archive (Open-Meteo)
# PRACK_WEATHER_INTERVAL_HOURS=3
# PRACK_WEATHER_BACKFILL_DAYS=30

# --- docker compose ----------------------------------------------------------
# PRACK_PUBLISH=127.0.0.1:8000    # only reachable through the Caddy HTTPS proxy
# PRACK_DOMAIN=prack.example.com
